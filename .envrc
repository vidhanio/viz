use flake

# Development config and state live together under .viz.local/ (gitignored);
# every viz program in this shell reads the one config file.
export VIZ_SERVER_CONFIG="$PWD/.viz.local/config/config.toml"
export VIZ_DESKTOP_CONFIG="$VIZ_SERVER_CONFIG"
export VIZ_CLI_CONFIG="$VIZ_SERVER_CONFIG"
export STATE_DIRECTORY="$PWD/.viz.local/state"
watch_file "$VIZ_SERVER_CONFIG"
