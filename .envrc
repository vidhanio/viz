use flake

# Backend-only configuration and separate per-client settings.
if [ -f viz.local.toml ]; then
  export VIZ_CONFIG="$PWD/viz.local.toml"
fi
if [ -f viz.local/desktop.toml ]; then
  export VIZ_DESKTOP_CONFIG="$PWD/viz.local/desktop.toml"
fi
if [ -f viz.local/cli.toml ]; then
  export VIZ_CLI_CONFIG="$PWD/viz.local/cli.toml"
fi
watch_file viz.local.toml
watch_file viz.local/desktop.toml
watch_file viz.local/cli.toml
