{
  "protocol": 1,
  "definitions": {
    "Origin": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string",
          "description": "Connector name, matching its `hello` name, e.g. discord"
        },
        "channel": {
          "type": "string",
          "description": "Connector-specific channel/chat id the reply goes to"
        },
        "thread": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "description": "Connector-specific id of the message being answered"
        },
        "author": {
          "type": "string",
          "description": "Human-readable author, shown to the model"
        }
      },
      "required": ["connector", "channel"],
      "additionalProperties": false
    }
  },
  "methods": {
    "hello": {
      "params": {
        "type": "object",
        "properties": {
          "protocol": {
            "const": 1
          },
          "client": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": ["app", "connector", "cli"]
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
          }
        },
        "required": ["protocol", "client"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "protocol": {
            "const": 1
          },
          "version": {
            "type": "string"
          },
          "root": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          }
        },
        "required": ["protocol", "version", "root"],
        "additionalProperties": false
      }
    },
    "conversations.list": {
      "params": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "conversations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "pi-durable ConversationId"
                },
                "title": {
                  "type": "string",
                  "description": "Set by the backend: fixed for the orchestrator, a subagent's task, a chat's first message; empty until known"
                },
                "kind": {
                  "enum": ["orchestrator", "chat", "subagent"]
                },
                "parent": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "For a subagent: the conversation that started it"
                },
                "project": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Backend-assigned project id"
                },
                "harness": {
                  "type": "string",
                  "description": "ACP runner name; absent for the orchestrator"
                },
                "status": {
                  "enum": ["idle", "working", "failed"],
                  "description": "working: a turn runs or inputs wait"
                },
                "archived": {
                  "type": "boolean"
                },
                "updatedAt": {
                  "type": "integer",
                  "description": "Unix milliseconds of the last input or turn end; 0 when unknown"
                },
                "unread": {
                  "type": "boolean",
                  "description": "A turn ended while no app watched the conversation; watching clears it"
                },
                "pinned": {
                  "type": "boolean"
                },
                "worktree": {
                  "type": "string",
                  "description": "Path of the viz-created git worktree the conversation runs in"
                }
              },
              "required": ["id", "title", "kind", "status", "archived", "updatedAt", "unread", "pinned"],
              "additionalProperties": false
            }
          }
        },
        "required": ["conversations"],
        "additionalProperties": false
      }
    },
    "conversation.create": {
      "params": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "description": "Backend-assigned project id"
          },
          "worktree": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "type": "string",
                "description": "Default: the project's current branch"
              }
            },
            "required": ["branch"],
            "additionalProperties": false,
            "description": "Run the chat in a new git worktree of the project on a new branch"
          },
          "harness": {
            "type": "string",
            "description": "Configured ACP runner; default [backend].default_harness"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "description": "Initial ConfigOption values by id, e.g. a model picked before the first message"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          }
        },
        "required": ["conversation"],
        "additionalProperties": false
      }
    },
    "conversation.update": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "archived": {
            "type": "boolean"
          },
          "pinned": {
            "type": "boolean"
          },
          "unread": {
            "type": "boolean"
          },
          "project": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Backend-assigned project id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["conversation"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "conversation.configure": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          },
          "option": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "required": ["conversation", "option", "value"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "conversation.abort": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          }
        },
        "required": ["conversation"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "conversation.delete": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          }
        },
        "required": ["conversation"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "kept": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Worktree paths left on disk rather than removed"
          }
        },
        "required": ["kept"],
        "additionalProperties": false
      }
    },
    "conversation.submit": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "Default: the root (orchestrator) conversation"
          },
          "text": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Idempotency key: a retry with the same id returns the same submission"
          },
          "origin": {
            "type": "object",
            "properties": {
              "connector": {
                "type": "string",
                "description": "Connector name, matching its `hello` name, e.g. discord"
              },
              "channel": {
                "type": "string",
                "description": "Connector-specific channel/chat id the reply goes to"
              },
              "thread": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "description": "Connector-specific id of the message being answered"
              },
              "author": {
                "type": "string",
                "description": "Human-readable author, shown to the model"
              }
            },
            "required": ["connector", "channel"],
            "additionalProperties": false
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "mime": {
                  "type": "string",
                  "description": "e.g. image/png, text/plain"
                },
                "data": {
                  "type": "string",
                  "description": "Base64, at most 20 MiB decoded"
                }
              },
              "required": ["name", "mime", "data"],
              "additionalProperties": false
            }
          }
        },
        "required": ["text"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "submission": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable SubmissionId"
          }
        },
        "required": ["submission"],
        "additionalProperties": false
      }
    },
    "conversation.watch": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          }
        },
        "required": ["conversation"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "watching": {
            "type": "boolean"
          }
        },
        "required": ["watching"],
        "additionalProperties": false
      }
    },
    "conversation.unwatch": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          }
        },
        "required": ["conversation"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "watching": {
            "type": "boolean"
          }
        },
        "required": ["watching"],
        "additionalProperties": false
      }
    },
    "projects.list": {
      "params": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Backend-assigned project id"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string",
                  "description": "Absolute directory; the cwd of the project's chats"
                },
                "branch": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Checked-out git branch, null outside a repository or when detached"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "createdAt": {
                  "type": "integer",
                  "description": "Unix milliseconds"
                }
              },
              "required": ["id", "name", "path", "branch", "createdAt"],
              "additionalProperties": false
            }
          }
        },
        "required": ["projects"],
        "additionalProperties": false
      }
    },
    "project.create": {
      "params": {
        "type": "object",
        "properties": {
