              "enum": ["idle", "working", "failed"],
              "description": "working: a turn runs or inputs wait"
            },
            "harness": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "project": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Backend-assigned project id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cwd": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "category": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "model | thought_level | mode | other ACP categories"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": {
                    "enum": ["select", "boolean"]
                  },
                  "choices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "group": {
                          "type": "string",
                          "description": "Group label, e.g. the model's provider"
                        },
                        "thinking": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "value": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "boolean"
                                }
                              ]
                            },
                            "choices": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "value": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "description": {
                                    "type": "string"
                                  }
                                },
                                "required": ["value", "name"],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": ["id", "name", "value", "choices"],
                          "additionalProperties": false,
                          "description": "Thinking levels reported for this model"
                        }
                      },
                      "required": ["value", "name"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["id", "name", "value", "category", "type", "choices"],
                "additionalProperties": false
              },
              "description": "Empty until the runner's session reports them"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Without the leading /"
                  },
                  "description": {
                    "type": "string"
                  },
                  "hint": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["name", "description", "hint"],
                "additionalProperties": false
              }
            },
            "queue": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "submission": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "pi-durable SubmissionId"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": ["submission", "text"],
                "additionalProperties": false
              },
              "description": "Inputs waiting for the next turn"
            },
            "attachments": {
              "type": "object",
              "properties": {
                "images": {
                  "type": "boolean",
                  "description": "The runner takes image prompts"
                }
              },
              "required": ["images"],
              "additionalProperties": false,
              "description": "What attachments the runner accepts; files always go as paths"
            },
            "live": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "turn": {
                      "type": "string",
                      "description": "EntryId of the turn's viz.agent.prompt entry"
                    },
                    "text": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "Also `data.key` of the viz.agent.text or viz.agent.thought entry that commits it"
                        },
                        "kind": {
                          "enum": ["text", "thought"]
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": ["key", "kind", "text"],
                      "additionalProperties": false
                    },
                    "tools": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "ACP toolCallId; unique within one turn"
                          },
                          "title": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string",
                            "description": "Programmatic tool name, when reported by the runner"
                          },
                          "kind": {
                            "anyOf": [
                              {
                                "type": "string",
                                "description": "ACP ToolKind: read | edit | execute | search | fetch | think | other ..."
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "status": {
                            "enum": ["pending", "in_progress", "completed", "failed"]
                          },
                          "viz": {
                            "type": "string",
                            "description": "The viz tool this call ran, when it was one"
                          },
                          "child": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "pi-durable ConversationId"
                          },
                          "startedAt": {
                            "type": "integer",
                            "description": "Unix milliseconds when viz first observed the call running"
                          },
                          "input": {
                            "type": "string",
                            "description": "Raw input: a string as sent, else JSON (fields such as command, path, timeout)"
                          },
                          "output": {
                            "type": "string",
                            "description": "ACP text content, else readable raw output"
                          },
                          "diffs": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "path": {
                                  "type": "string"
                                },
                                "oldText": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "newText": {
                                  "type": "string"
                                }
                              },
                              "required": ["path", "oldText", "newText"],
                              "additionalProperties": false
                            }
                          },
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": ["id", "title", "kind", "status"],
                        "additionalProperties": false
                      },
                      "description": "Unfinished tool calls, in the order they started"
                    }
                  },
                  "required": ["turn", "tools"],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "An ACP turn's in-progress text and tools; null when none runs"
            },
            "usage": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "used": {
                      "type": "integer",
                      "description": "Tokens in context"
                    },
                    "size": {
                      "type": "integer",
                      "description": "Context window in tokens"
                    }
                  },
                  "required": ["used", "size"],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "The ACP runner's last usage_update; null until it sends one"
            }
          },
          "required": [
            "status",
            "harness",
            "project",
            "cwd",
            "options",
            "commands",
            "queue",
            "attachments",
            "live",
            "usage"
          ],
          "additionalProperties": false
        }
      },
      "required": ["conversation", "state"],
      "additionalProperties": false
    },
    "conversations.changed": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "object",
          "properties": {
            "connector": {
              "type": "string",
              "description": "Connector name, matching its `hello` name, e.g. discord"
            },
            "channel": {
              "type": "string",
              "description": "Connector-specific channel/chat id the reply goes to"
            },
            "thread": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "description": "Connector-specific id of the message being answered"
            },
            "author": {
              "type": "string",
              "description": "Human-readable author, shown to the model"
            }
          },
          "required": ["connector", "channel"],
          "additionalProperties": false
        },
        "conversation": {
          "type": "integer",
          "minimum": 1,
          "description": "pi-durable ConversationId"
        },
        "submission": {
          "type": "integer",
          "minimum": 1,
          "description": "pi-durable SubmissionId"
        },
        "status": {
          "enum": ["done", "unanswered"]
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["origin", "conversation", "submission", "status", "text"],
      "additionalProperties": false
    }
  }
}
