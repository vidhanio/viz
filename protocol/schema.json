            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          },
          "before": {
            "type": "integer",
            "minimum": 1,
            "description": "Return entries with smaller ids than this"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": ["conversation", "before"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {},
            "description": "pi-durable EntryRecords in ascending id order, as in the view"
          },
          "before": {
            "type": "integer",
            "description": "Set when older entries remain"
          }
        },
        "required": ["entries"],
        "additionalProperties": false
      }
    },
