          "harness": {
            "type": "string",
            "description": "Configured ACP runner; default [backend].default_harness"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "description": "Initial ConfigOption values by id, e.g. a model picked before the first message"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
