{
  "protocol": 1,
  "definitions": {
    "Origin": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string",
          "description": "Connector name, matching its `hello` name, e.g. discord"
        },
        "channel": {
          "type": "string",
          "description": "Connector-specific channel/chat id the reply goes to"
        },
        "thread": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "description": "Connector-specific id of the message being answered"
        },
        "author": {
          "type": "string",
          "description": "Human-readable author, shown to the model"
        }
      },
      "required": ["connector", "channel"],
      "additionalProperties": false
    }
  },
  "methods": {
    "hello": {
      "params": {
        "type": "object",
        "properties": {
          "protocol": {
            "const": 1
          },
          "client": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": ["app", "connector", "cli"]
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
          }
        },
        "required": ["protocol", "client"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "protocol": {
            "const": 1
          },
          "version": {
            "type": "string"
          },
          "root": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          }
        },
        "required": ["protocol", "version", "root"],
        "additionalProperties": false
      }
    },
    "conversations.list": {
      "params": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "conversations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "pi-durable ConversationId"
                },
                "title": {
                  "type": "string",
                  "description": "A user rename, an ACP session title, or a title from the first prompt; fixed for the orchestrator"
                },
                "kind": {
                  "enum": ["orchestrator", "chat", "subagent"]
                },
                "parent": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "For a subagent: the conversation that started it"
                },
                "project": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Backend-assigned project id"
                },
                "harness": {
                  "type": "string",
                  "description": "ACP runner name; absent for the orchestrator"
                },
                "status": {
                  "enum": ["idle", "working", "failed"],
                  "description": "working: a turn runs or inputs wait"
                },
                "archived": {
                  "type": "boolean"
                },
                "updatedAt": {
                  "type": "integer",
                  "description": "Unix milliseconds of the last input or turn end; 0 when unknown"
                },
                "unread": {
                  "type": "boolean",
                  "description": "A turn ended while no app watched the conversation; watching clears it"
                },
                "pinned": {
                  "type": "boolean"
                },
                "model": {
                  "type": "string",
                  "description": "Display name of the selected model, once the runner or orchestrator reports it"
                },
                "thinking": {
                  "type": "string",
                  "description": "Display name of the selected thinking level, when the model has one"
                }
              },
              "required": ["id", "title", "kind", "status", "archived", "updatedAt", "unread", "pinned"],
              "additionalProperties": false
            }
          }
        },
        "required": ["conversations"],
        "additionalProperties": false
      }
    },
    "conversation.create": {
      "params": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "description": "Backend-assigned project id"
