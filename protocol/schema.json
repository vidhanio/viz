    "git.revert": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          },
          "turn": {
            "type": "integer",
            "minimum": 1,
            "description": "Restore the working tree to the start of this turn (prompt entry id)"
          }
        },
        "required": ["conversation", "turn"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  "notifications": {
    "conversation.view": {
      "type": "object",
      "properties": {
        "conversation": {
          "type": "integer",
          "minimum": 1,
          "description": "pi-durable ConversationId"
        },
        "value": {},
        "ops": {}
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "conversation.state": {
      "type": "object",
      "properties": {
        "conversation": {
          "type": "integer",
          "minimum": 1,
          "description": "pi-durable ConversationId"
        },
        "state": {
          "type": "object",
          "properties": {
            "status": {
              "enum": ["idle", "working", "failed"],
              "description": "working: a turn runs or inputs wait"
            },
            "harness": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "project": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Backend-assigned project id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cwd": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "readOnly": {
              "type": "boolean",
              "description": "Inputs are refused: a subagent while its delegating call still runs"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "category": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "model | thought_level | mode | other ACP categories"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": {
                    "enum": ["select", "boolean"]
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "choices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "group": {
                          "type": "string",
                          "description": "Group label"
                        }
                      },
                      "required": ["value", "name"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["id", "name", "category", "type", "value", "choices"],
                "additionalProperties": false
              },
              "description": "Empty until the runner's session reports them"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Without the leading /"
                  },
                  "description": {
                    "type": "string"
                  },
                  "hint": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["name", "description", "hint"],
                "additionalProperties": false
              }
            },
            "queue": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "submission": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "pi-durable SubmissionId"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": ["submission", "text"],
                "additionalProperties": false
              },
              "description": "Inputs waiting for the next turn"
            },
            "git": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "branch": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "Null when detached"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "upstream": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "ahead": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "behind": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "worktree": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "Path of the viz-created worktree this conversation runs in"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "description": "Relative to the repository root"
                          },
                          "status": {
                            "enum": ["modified", "added", "deleted", "renamed", "untracked", "conflicted"]
                          },
                          "staged": {
                            "type": "boolean"
                          }
                        },
                        "required": ["path", "status", "staged"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["branch", "upstream", "ahead", "behind", "worktree", "files"],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "attachments": {
              "type": "object",
              "properties": {
                "images": {
                  "type": "boolean",
                  "description": "The runner takes image prompts"
                }
              },
              "required": ["images"],
              "additionalProperties": false,
              "description": "What attachments the runner accepts; files always go as paths"
            }
          },
          "required": [
            "status",
            "harness",
            "project",
            "cwd",
            "readOnly",
            "options",
            "commands",
            "queue",
            "git",
            "attachments"
          ],
          "additionalProperties": false
        }
      },
      "required": ["conversation", "state"],
      "additionalProperties": false
    },
    "conversations.changed": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "object",
          "properties": {
            "connector": {
              "type": "string",
              "description": "Connector name, matching its `hello` name, e.g. discord"
            },
            "channel": {
              "type": "string",
              "description": "Connector-specific channel/chat id the reply goes to"
            },
            "thread": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "description": "Connector-specific id of the message being answered"
            },
            "author": {
              "type": "string",
              "description": "Human-readable author, shown to the model"
            }
          },
          "required": ["connector", "channel"],
          "additionalProperties": false
        },
        "conversation": {
          "type": "integer",
          "minimum": 1,
          "description": "pi-durable ConversationId"
        },
        "submission": {
          "type": "integer",
          "minimum": 1,
          "description": "pi-durable SubmissionId"
        },
        "status": {
          "enum": ["done", "unanswered"]
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["origin", "conversation", "submission", "status", "text"],
      "additionalProperties": false
    }
  }
}
