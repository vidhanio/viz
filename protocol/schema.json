              },
              "branch": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Checked-out git branch, null outside a repository or when detached"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "integer",
                "description": "Unix milliseconds"
              }
            },
            "required": ["id", "name", "path", "branch", "createdAt"],
            "additionalProperties": false
          }
        },
        "required": ["project"],
        "additionalProperties": false
      }
    },
    "project.update": {
      "params": {
