    "files.search": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          },
          "query": {
            "type": "string",
            "description": "Fuzzy path query; empty lists the first files"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": ["conversation", "query"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Path relative to the conversation's cwd"
            }
          }
        },
        "required": ["files"],
        "additionalProperties": false
      }
    },
    "conversations.search": {
      "params": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "conversation": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "pi-durable ConversationId"
                },
                "entry": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "pi-durable EntryId"
                },
                "snippet": {
                  "type": "string",
                  "description": "Matching text with the match wrapped in \u0001 \u0002 markers"
                }
              },
              "required": ["conversation", "entry", "snippet"],
              "additionalProperties": false
            }
          }
        },
        "required": ["hits"],
        "additionalProperties": false
      }
    },
    "conversation.entries": {
      "params": {
        "type": "object",
        "properties": {
