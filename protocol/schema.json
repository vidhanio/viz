    "conversation.submit": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "Default: the root (orchestrator) conversation"
          },
          "text": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Idempotency key: a retry with the same id returns the same submission"
          },
          "origin": {
            "type": "object",
            "properties": {
              "connector": {
                "type": "string",
                "description": "Connector name, matching its `hello` name, e.g. discord"
              },
              "channel": {
                "type": "string",
                "description": "Connector-specific channel/chat id the reply goes to"
              },
              "thread": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "description": "Connector-specific id of the message being answered"
              },
              "author": {
                "type": "string",
                "description": "Human-readable author, shown to the model"
              }
            },
            "required": ["connector", "channel"],
            "additionalProperties": false
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "mime": {
                  "type": "string",
                  "description": "e.g. image/png, text/plain"
                },
                "data": {
                  "type": "string",
                  "description": "Base64, at most 20 MiB decoded"
                }
              },
              "required": ["name", "mime", "data"],
              "additionalProperties": false
            }
          }
        },
        "required": ["text"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "submission": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable SubmissionId"
          }
        },
        "required": ["submission"],
        "additionalProperties": false
      }
    },
