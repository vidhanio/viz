    "git.diff": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "integer",
            "minimum": 1,
            "description": "pi-durable ConversationId"
          },
          "scope": {
            "enum": ["worktree", "turn", "branch"],
            "description": "worktree: uncommitted changes; turn: since the start of `turn`; branch: against the base branch"
          },
          "turn": {
            "type": "integer",
            "minimum": 1,
            "description": "For scope turn: the prompt entry id; default the latest turn"
          },
          "path": {
            "type": "string"
          }
        },
        "required": ["conversation", "scope"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "oldPath": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "enum": ["modified", "added", "deleted", "renamed"]
                },
                "additions": {
                  "type": "integer"
                },
                "deletions": {
                  "type": "integer"
                },
                "patch": {
                  "type": "string",
                  "description": "Unified diff of this file, capped at 200 KB"
                }
              },
              "required": ["path", "oldPath", "status", "additions", "deletions", "patch"],
              "additionalProperties": false
            }
          }
        },
        "required": ["files"],
        "additionalProperties": false
      }
    },
